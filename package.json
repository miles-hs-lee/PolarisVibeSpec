{
  "name": "polaris-vibe-spec",
  "version": "0.1.0",
  "description": "Spec-driven coding layer between a GitHub repo and an AI coding agent. Graph = memory, Markdown = view, CLI = control surface, AI = compiler, Codex = executor.",
  "bin": {
    "pv": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "validate": "node dist/cli.js validate",
    "spec": "node dist/cli.js export-all",
    "spec:check": "node dist/cli.js export-all && git diff --quiet spec/",
    "diagrams": "python3 scripts/regen-diagrams.py",
    "diagrams:check": "python3 scripts/regen-diagrams.py && git diff --quiet docs/ARCHITECTURE.md docs/ARCHITECTURE.ko.md",
    "health": "node dist/cli.js health --pretty",
    "pv": "node dist/cli.js",
    "test": "tsx --test test/*.test.ts"
  },
  "files": [
    "dist",
    "skills",
    "docs/ADOPTION.en.md",
    "docs/ADOPTION.ko.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "spec",
    "spec-driven",
    "graph",
    "claude-code",
    "codex",
    "ai-agent",
    "code-review",
    "impact-analysis",
    "cli",
    "polaris-vibe-spec"
  ],
  "homepage": "https://github.com/miles-hs-lee/PolarisVibeSpec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miles-hs-lee/PolarisVibeSpec.git"
  },
  "bugs": {
    "url": "https://github.com/miles-hs-lee/PolarisVibeSpec/issues"
  },
  "author": "Miles HS Lee",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
